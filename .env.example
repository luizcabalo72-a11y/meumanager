# ========================================
# .env.example - COPIE PARA .env (NÃO COMMITE!)
# ========================================
# Este é um arquivo de EXEMPLO
# Copie para .env e preencha com seus valores reais
# NUNCA commite .env no Git!

# ========== AMBIENTE ==========
NODE_ENV=production

# ========== STRIPE ==========
# Obtenha em: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_coloque_sua_chave_secreta_aqui
STRIPE_PUBLISHABLE_KEY=pk_live_coloque_sua_chave_publica_aqui
STRIPE_WEBHOOK_SECRET=whsec_coloque_seu_webhook_secret_aqui

# ========== MERCADO PAGO ==========
# Obtenha em: https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=seu_access_token_aqui
MP_PUBLIC_KEY=APP_USR_sua_chave_publica_aqui
MP_WEBHOOK_SECRET=seu_webhook_secret_mp_aqui
# true/false - se vazio, ativa automaticamente quando MP_WEBHOOK_SECRET estiver configurado
MP_WEBHOOK_ENFORCE_SIGNATURE=true

# ========== FIREBASE ==========
# Obtenha em: https://console.firebase.google.com
FIREBASE_PROJECT_ID=meumanager-b02b0
FIREBASE_DB_URL=https://meumanager-b02b0.firebaseio.com
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ========== GOOGLE CLOUD ==========
GCLOUD_PROJECT=meumanager-b02b0

# ========== APLICAÇÃO ==========
PORT=3000
LOG_LEVEL=info

# ========== EMAIL (SMTP) ==========
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=contato@seudominio.com
SMTP_PASS=sua_senha_smtp
SMTP_FROM=Meu Manager <contato@seudominio.com>
SMTP_SECURE=false

# ========== ALERTAS TRIAL ==========
# Emails separados por virgula
ADMIN_EMAILS=admin@seudominio.com
TRIAL_ALERT_DAYS=3,1,0
